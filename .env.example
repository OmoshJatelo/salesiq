# ── SalesIQ Environment Configuration ────────────────────────────────────────
# 1. cp .env.example .env
# 2. Fill in your real values
# 3. Never commit .env to Git

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=salesiq_db
DB_USER=salesiq_user
DB_PASS=your_secure_password

# App
APP_ENV=development
APP_DEBUG=true

# Base URL — the subfolder your project lives in (no trailing slash)
# Examples:
#   Running at http://localhost/Salesiq  →  APP_BASE=/Salesiq
#   Running at http://localhost/         →  APP_BASE=
#   Running at https://salesiq.co.ke/   →  APP_BASE=
APP_BASE=/Salesiq

# M-Pesa (Safaricom Daraja API)
# Register at: https://developer.safaricom.co.ke/
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_lipa_na_mpesa_passkey
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_ENV=sandbox
MPESA_CALLBACK_URL=https://yourdomain.co.ke/mpesa_callback.php


